---
interface Props {
  /** Noun used in the accessible labels, e.g. "slide" or "thumbnail". */
  noun?: string;
}

const { noun = "slide" } = Astro.props;
---

<button type="button" class="aero-slider__nav--prev" aria-label={`Previous ${noun}`}>
  <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m15 18-6-6 6-6"></path></svg>
</button>
<button type="button" class="aero-slider__nav--next" aria-label={`Next ${noun}`}>
  <svg fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="m9 18 6-6-6-6"></path></svg>
</button>
