---
import pkg from "../../../package.json";
import BaseLayout from "../layouts/BaseLayout.astro";
import CodeBlock from "../components/CodeBlock.astro";
import DocTable from "../components/DocTable.astro";
import Entry from "../components/Entry.astro";
import Logo from "../components/Logo.astro";
import Pagination from "../components/Pagination.astro";
import SliderNav from "../components/SliderNav.astro";
import Slides from "../components/Slides.astro";
import { heroToneFor, type SlideContent } from "../lib/slide";

const REPO = "https://github.com/Negative-Space-Dev/aero-slider";

const features = [
  "CSS-First Architecture",
  "~8 KB gzipped",
  "Zero Dependencies",
  "Highly Extensible",
  "Native Scroll Snapping",
  "Touch & Swipe Friendly",
  "Accessible",
  "Infinite Looping",
  "Smooth Autoplay",
  "Multi-Slide Views",
  "Responsive API",
  "Custom Pagination",
  "Thumbnail Syncing",
  "Event Callbacks",
  "Zero CLS",
  "Keyboard Nav",
];

const packageManagers = ["bun", "npm", "yarn", "pnpm"];

// Playground controls. Ids and names are read by the inline script below and
// by scripts/examples.ts.
const ranges = [
  { id: "slideCount", name: "slideCount", out: "slideCount", label: "Number of slides", min: 3, max: 20, step: 1, value: 5, display: "5" },
  { id: "spv", name: "slidesPerView", out: "spv", label: "Slides per view", min: 0, max: 16, step: 1, value: 0, display: "1" },
  { id: "gap", name: "gap", out: "gap", label: "Gap", min: 0, max: 32, step: 2, value: 10, display: "10px" },
  { id: "perMove", name: "perMove", out: "perMove", label: "Per move", min: 1, max: 4, step: 1, value: 1, display: "1" },
  { id: "maxDots", name: "maxDots", out: "maxDots", label: "Max dots", min: 3, max: 21, step: 1, value: 9, display: "9" },
  { id: "interval", name: "autoplayInterval", out: "interval", label: "Autoplay interval", min: 1000, max: 8000, step: 500, value: 4000, display: "4000ms", wrapperId: "interval-control" },
];

const choices = [
  { name: "alignment", label: "Alignment", selected: "center", options: [["left", "Left"], ["center", "Center"], ["right", "Right"]] },
  { name: "direction", label: "Direction", selected: "ltr", options: [["ltr", "LTR"], ["rtl", "RTL"], ["ttb", "Vertical"]] },
];

const toggles = [
  { name: "loop", label: "Loop", checked: false },
  { name: "pagination", label: "Pagination", checked: true },
  { name: "navigation", label: "Navigation", checked: true },
  { name: "draggable", label: "Draggable", checked: true },
  { name: "autoplay", label: "Autoplay", checked: false },
  { name: "thumbnails", label: "Thumbnails", checked: false },
];

const ORDINALS = ["One", "Two", "Three", "Four", "Five"];
const heroSlides: SlideContent[] = ORDINALS.map((ordinal, i) => ({
  num: i + 1,
  label: `Slide ${ordinal}`,
  tone: heroToneFor(i + 1),
}));
const heroThumbs: SlideContent[] = heroSlides.map(({ num, tone }) => ({ num, tone }));

const letters = (list: string): SlideContent[] => [...list].map((num) => ({ num }));

const breakoutSlides: SlideContent[] = [
  { num: 1, label: "Aligned", text: "The active card is still positioned from the main content column." },
  { num: 2, label: "Bleed", text: "The scroll area reaches the page edge, but slide sizing still keys off the content width." },
  { num: 3, label: "Viewport", text: "That makes the next and previous slides feel like they continue off-screen." },
  { num: 4, label: "Host Layout", text: "The site still owns the breakout wrapper and gutter math around the slider." },
  { num: 5, label: "Edges", text: "The edge gutter is derived from the track width, so it stays scrollbar-correct on its own." },
];

const responsiveSlides: SlideContent[] = ["Mobile", "Tablet", "Desktop", "Wide", "Extra"].map(
  (label, i) => ({ num: i + 1, label })
);

const autoplaySlides: SlideContent[] = [
  { num: "Night", label: "01", tone: 1 },
  { num: "Sunset", label: "02", tone: 3 },
  { num: "Day", label: "03", tone: 2 },
  { num: "Dawn", label: "04", tone: 5 },
];

const thumbnailMainSlides: SlideContent[] = [1, 2, 3, 4].map((num) => ({ num, label: "Main slide" }));

const alignments = ["left", "center", "right"];

// ── API reference tables. Cells are HTML strings. ─────────────────────
const globalRows = [
  ["AeroSlider.createSlider", "Same as the module <code>createSlider</code> — creates a slider instance"],
  ["AeroSlider.syncThumbnails", "Same as the module <code>syncThumbnails</code> — syncs primary and thumbnail sliders"],
];

const cssPropertyRows = [
  ["--slides-per-view", "1", "Number of visible slides (supports fractional, e.g. 1.5)"],
  ["--slide-gap", "0px", "Gap between slides"],
  ["--slide-aspect", "5 / 3", "Aspect ratio for slides"],
  ["--aero-layout-width", "100%", "Content column width for <code>aero-slider--breakout</code> sliders. Slides size to this column while the track spans the full width; edge gutters are derived automatically."],
  ["data-aero-defer-visibility", "—", "Prevents layout shift before JS init in loop mode by reserving space for prepended clones. Pair it with <code>data-aero-alignment</code> in HTML when mirroring a non-default pre-init alignment; center is assumed otherwise."],
];

const stateClassRows = [
  ["aero-slider--ready", "The slider has initialized"],
  ["aero-slider--draggable", "<code>draggable</code> is on. The track shows the <code>grab</code> cursor only then"],
  ["aero-slider--dragging", "A mouse or pen drag is in progress (<code>grabbing</code> cursor)"],
  ["aero-slider--free", '<code>snap</code> is <code>"settle"</code> or <code>"none"</code>. Turns CSS scroll snapping off'],
  ["aero-slider--vertical", '<code>direction</code> is <code>"ttb"</code>'],
];

const configRows = [
  ["loop", "boolean", "false", "Infinite looping"],
  ["alignment", '"left" | "center" | "right"', '"center"', "Align the active slide to the left, center, or right when possible. At non-loop edges the scroll position clamps, but <code>currentIndex</code> still reflects the focused slide."],
  ["draggable", "boolean", "true", "Enable mouse and pen dragging. Touch always swipes natively"],
  ["autoplay", 'boolean | "continuous"', "false", '<code>true</code> advances one move every <code>autoplayInterval</code>. <code>"continuous"</code> drifts the track smoothly like a ticker at <code>autoplaySpeed</code>; it implies <code>loop</code> and <code>snap: "none"</code>'],
  ["autoplaySpeed", "number", "40", "Continuous autoplay speed in pixels per second. <code>0</code> or less keeps the track still"],
  ["autoplayInterval", "number", "5000", "Delay between auto-advances (ms). Restarts after any manual change, and holds while the slider is pressed"],
  ["maxDots", "number", "0", "Max pagination dots (0 = unlimited); shows iOS-style sliding window when exceeded"],
  ["noDrag", "string", '""', 'CSS selector for elements inside slides that should not trigger drag (e.g. <code>"a, button, input"</code>)'],
  ["perMove", "number", "1", "Number of slides to advance per <code>next()</code> / <code>prev()</code> call"],
  ["direction", '"ltr" | "rtl" | "ttb"', '"ltr"', "Carousel direction: left-to-right, right-to-left, or top-to-bottom (vertical)"],
  ["snap", '"native" | "settle" | "none"', '"native"', 'How the track comes to rest. <code>"native"</code> uses CSS scroll snapping. <code>"settle"</code> scrolls freely, then eases onto the nearest slide once scrolling stops (with <code>scrollDuration</code> / <code>scrollEasing</code>). <code>"none"</code> rests wherever the track stops'],
  ["scrollDuration", "number", "0", "Length of <code>next()</code> / <code>prev()</code> / <code>goTo()</code> scrolls in ms, eased by <code>scrollEasing</code>, so they move the same way in every browser. <code>0</code> uses the browser's native smooth scrolling. Reduced motion makes every scroll instant either way"],
  ["scrollEasing", "(t: number) =&gt; number", "ease-out cubic", "Maps linear progress 0–1 to eased progress for <code>scrollDuration</code> scrolls, e.g. <code>(t) =&gt; t</code> for linear"],
];

const instanceRows = [
  [".next()", "Go to next slide"],
  [".prev()", "Go to previous slide"],
  [".goTo(index, options?)", "Scroll to a specific slide index. Pass <code>{ instant: true }</code> to jump there with no animation"],
  [".pause()", "Hold autoplay until <code>.resume()</code>. Hover, focus and drag pauses still apply on top"],
  [".resume()", "Release a <code>.pause()</code> and restart the autoplay countdown"],
  [".update(config?)", "Update config and re-render"],
  [".destroy()", "Tear down and clean up"],
  [".refresh()", "Re-read slides from DOM and rebuild (call after external DOM changes)"],
  [".add(slides, index?)", "Insert one or more slides into the track; calls refresh() automatically"],
  [".remove(index)", "Remove slide(s) by index (number or array); calls refresh() automatically"],
  [".element", "The container element the slider is attached to (read-only)"],
  [".currentIndex", "Current active slide index (read-only)"],
  [".slideCount", "Total number of slides (read-only)"],
];

const eventRows = [
  ["aero:ready", "{}", "Fired once after initialization (listen before <code>createSlider</code>)"],
  ["aero:slideChange", "{ index: number }", "Fired when the active slide changes"],
  ["aero:dragStart", "{ index: number }", "Fired when a mouse or pen drag starts (touch scrolls natively and doesn't fire drag events)"],
  ["aero:dragEnd", "{ index: number; fromIndex: number }", "Fired when a mouse or pen drag is released, after the target slide is chosen"],
  ["aero:autoplayStart", "{}", "Fired when autoplay starts or resumes"],
  ["aero:autoplayStop", "{}", "Fired when autoplay pauses"],
  ["aero:visible", "{ index: number }", "Fired per slide when it enters the visible range"],
  ["aero:hidden", "{ index: number }", "Fired per slide when it leaves the visible range"],
  ["aero:resize", "{}", "Fired when the track or slide size changes, e.g. a window resize or a CSS variable such as <code>--slides-per-view</code> changing (before re-measuring)"],
  ["aero:resized", "{}", "Fired after the slider finishes updating from a resize"],
  ["aero:destroy", "{}", "Fired at the start of <code>destroy()</code>, before teardown"],
];

const browserRows = [
  ["CSS Variables", "49+", "9.1+", "31+", "Configuring layout and gap size."],
  ["Scroll Snapping", "69+", "11+", "68+", "Locking slides into place after scrolling."],
  ["aspect-ratio", "88+", "15+", "89+", "Maintaining proper height for the slider track."],
  ["contain: paint", "52+", "15.4+", "69+", "Performance optimization for painting slides."],
  ["overscroll-behavior-x", "63+", "16+", "59+", "Preventing rubber-banding when hitting the edge."],
];
---

<BaseLayout title="Aero Slider — Lightweight CSS-first Slider">
  <Fragment slot="head">
    <script>
      import "../scripts/examples.ts";
    </script>
  </Fragment>

  <!-- ─── Navbar ──────────────────────────────────────────────── -->
  <header class="sticky top-0 z-50 border-b border-line bg-paper/80 backdrop-blur-md">
    <div class="container-page flex h-14 items-center justify-between gap-4">
      <a href="/" class="flex items-center gap-2.5 text-[0.9375rem] font-medium tracking-tight text-ink">
        <Logo class="size-5" />
        Aero Slider
        <span class="hidden rounded-full border border-line px-2 py-0.5 font-mono text-[0.6875rem] font-normal tracking-normal text-faint sm:inline">
          v{pkg.version}
        </span>
      </a>
      <nav class="flex items-center gap-5 text-sm text-muted sm:gap-7" aria-label="Primary">
        <a href="#examples" class="transition-colors hover:text-ink">Examples</a>
        <a href="#api" class="transition-colors hover:text-ink">API</a>
        <a href={REPO} target="_blank" rel="noopener" class="transition-colors hover:text-ink" aria-label="GitHub">
          <svg class="size-5" fill="currentColor" viewBox="0 0 24 24" aria-hidden="true">
            <path
              fill-rule="evenodd"
              d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844c.85.004 1.705.115 2.504.337 1.654-1.093 2.75-1.026 2.75-1.026.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"
              clip-rule="evenodd"></path>
          </svg>
        </a>
      </nav>
    </div>
  </header>

  <main>
    <!-- ════════════════════════════════════════════════════════════
         HERO
         ════════════════════════════════════════════════════════════ -->
    <section class="container-page pt-14 pb-12 sm:pt-24 sm:pb-16">
      <div class="grid items-end gap-10 lg:grid-cols-[minmax(0,1.25fr)_minmax(0,1fr)] lg:gap-16">
        <div>
          <p class="caption mb-6 flex items-center gap-2.5">
            <span class="size-1.5 rounded-full bg-accent shadow-[0_0_0_3px_color-mix(in_srgb,var(--accent)_18%,transparent)]"></span>
            V1 coming soon
            <span class="text-line-strong">/</span>
            ~8 KB gzipped
          </p>
          <h1 class="text-[clamp(2.75rem,7.2vw,5.5rem)] leading-[0.95] font-medium tracking-[-0.045em] text-balance">
            CSS-first slider for the modern web
          </h1>
        </div>

        <div class="lg:pb-1.5">
          <p class="mb-6 max-w-md leading-relaxed text-muted">
            Native scroll snapping does the scrolling. JavaScript only handles events, loop
            cloning, pagination and autoplay, with zero dependencies.
          </p>

          <!-- Install Widget -->
          <div id="install-widget" class="max-w-md rounded-xl border border-line bg-surface">
            <div class="flex items-center justify-between border-b border-line pr-2 pl-1.5">
              <div class="flex">
                {
                  packageManagers.map((pm) => (
                    <button
                      type="button"
                      data-pm={pm}
                      class="install-tab -mb-px border-b border-transparent px-2.5 py-2.5 font-mono text-xs text-faint transition-colors hover:text-ink data-[active]:border-accent data-[active]:text-ink"
                    >
                      {pm}
                    </button>
                  ))
                }
              </div>
              <a
                href={`${REPO}/releases/latest`}
                target="_blank"
                rel="noopener noreferrer"
                class="flex items-center gap-1.5 rounded-md px-2 py-1 font-mono text-xs text-faint transition-colors hover:text-ink"
                title="Download .zip"
              >
                <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
                </svg>
                .zip
              </a>
            </div>
            <div class="flex items-center justify-between gap-3 py-2.5 pr-2.5 pl-4">
              <p class="min-w-0 truncate font-mono text-sm text-ink">
                <span class="text-faint select-none" aria-hidden="true">$ </span><span id="install-command">bun add aero-slider</span>
              </p>
              <button
                id="copy-install"
                type="button"
                class="rounded-md p-2 text-faint transition-colors hover:bg-line hover:text-ink"
                aria-label="Copy to clipboard"
              >
                <svg id="copy-icon" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
                  <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
                </svg>
                <svg id="check-icon" class="hidden size-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
                  <polyline points="20 6 9 17 4 12"></polyline>
                </svg>
              </button>
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Feature ticker: three identical sets, shifted by one set per loop -->
    <div class="overflow-hidden border-y border-line [mask-image:linear-gradient(to_right,transparent,black_10%,black_90%,transparent)]">
      <div class="animate-marquee flex w-max py-4">
        {
          [0, 1, 2].map((set) => (
            <ul class="flex shrink-0" aria-hidden={set > 0 ? "true" : undefined}>
              {features.map((feature) => (
                <li class="caption flex items-center gap-7 pr-7 whitespace-nowrap">
                  {feature}
                  <span class="size-1 rotate-45 bg-line-strong" />
                </li>
              ))}
            </ul>
          ))
        }
      </div>
    </div>

    <!-- ════════════════════════════════════════════════════════════
         PLAYGROUND
         ════════════════════════════════════════════════════════════ -->
    <section class="container-page py-12 sm:py-16" aria-labelledby="playground-title">
      <div class="mb-4 flex items-baseline justify-between gap-4">
        <h2 id="playground-title" class="caption">Playground</h2>
        <p class="caption tracking-normal normal-case">Settings are saved in the URL</p>
      </div>

      <div class="grid overflow-hidden rounded-2xl border border-line bg-surface lg:grid-cols-[minmax(0,1fr)_20rem]">
        <div class="flex min-w-0 flex-col">
          <div class="p-3 sm:p-5">
            <!-- Main Hero Slider -->
            <div id="hero-slider" class="aero-slider w-full">
              <div class="aero-slider__viewport relative">
                <SliderNav />
                <div class="aero-slider__track">
                  <Slides items={heroSlides} />
                </div>
              </div>
              <Pagination />
            </div>

            <!-- Thumbnail Strip -->
            <div id="hero-thumbs-wrapper" hidden class="mt-1">
              <div
                id="hero-thumbs"
                class="aero-slider aero-slider--thumbnails"
                style="--slide-aspect: 16/9; --slides-per-view: 5; --slide-gap: 8px;"
              >
                <div class="aero-slider__viewport relative">
                  <SliderNav noun="thumbnail" />
                  <div class="aero-slider__track">
                    <Slides items={heroThumbs} />
                  </div>
                </div>
              </div>
            </div>
          </div>

          <!-- Event Log -->
          <div id="event-log-container" class="flex flex-1 flex-col border-t border-line">
            <button
              type="button"
              id="event-log-toggle"
              class="flex w-full items-center justify-between px-5 py-3 text-left sm:cursor-default"
            >
              <span class="caption">Event log</span>
              <span id="event-log-icon" class="text-faint sm:hidden"></span>
            </button>
            <div id="event-log-content" class="relative min-h-44 flex-1 border-t border-line">
              <div class="absolute inset-0 overflow-auto">
                <div id="event-log-empty" class="flex h-full items-center justify-center px-4 text-center">
                  <p class="text-sm text-faint">Interact with the slider to see events</p>
                </div>
                <table class="hidden w-full min-w-[300px] font-mono text-xs" id="event-log-table">
                  <thead>
                    <tr class="text-left">
                      <th class="caption px-5 pt-3 pb-2">Event</th>
                      <th class="caption px-5 pt-3 pb-2">Data</th>
                      <th class="caption px-5 pt-3 pb-2">Time</th>
                    </tr>
                  </thead>
                  <tbody id="event-log"></tbody>
                </table>
              </div>
            </div>
          </div>
        </div>

        <!-- Config Panel -->
        <aside class="border-t border-line p-5 lg:border-t-0 lg:border-l">
          <h2 class="caption mb-5">Configuration</h2>
          <form id="config-form" class="space-y-5">
            {
              ranges.map((range) => (
                <div id={range.wrapperId} class="transition-opacity">
                  <div class="mb-1.5 flex items-center justify-between text-sm">
                    <label for={range.id} class="text-muted">
                      {range.label}
                    </label>
                    <output id={`out-${range.out}`} class="font-mono text-xs text-ink tabular-nums">
                      {range.display}
                    </output>
                  </div>
                  <input
                    id={range.id}
                    type="range"
                    name={range.name}
                    min={range.min}
                    max={range.max}
                    step={range.step}
                    value={range.value}
                  />
                </div>
              ))
            }

            {
              choices.map((choice) => (
                <fieldset>
                  <legend class="mb-1.5 text-sm text-muted">{choice.label}</legend>
                  <div class="segmented flex w-full">
                    {choice.options.map(([value, label]) => (
                      <label>
                        <input
                          type="radio"
                          name={choice.name}
                          value={value}
                          checked={value === choice.selected}
                          class="sr-only"
                        />
                        <span>{label}</span>
                      </label>
                    ))}
                  </div>
                </fieldset>
              ))
            }

            <fieldset class="border-t border-line pt-5">
              <legend class="sr-only">Feature toggles</legend>
              <div class="grid grid-cols-2 gap-2">
                {
                  toggles.map((toggle) => (
                    <label class="toggle">
                      <input type="checkbox" name={toggle.name} checked={toggle.checked} class="sr-only" />
                      <span>{toggle.label}</span>
                    </label>
                  ))
                }
              </div>
            </fieldset>
          </form>
          <!-- Apply URL params to form immediately, before module script loads -->
          <script is:inline>
            (function(){
              var q=location.search;if(!q||q.length<2)return;
              var p=new URLSearchParams(q),f=document.getElementById('config-form');
              if(!f)return;
              var SPV=[1,1.05,1.1,1.15,1.2,1.25,1.3,1.35,1.4,1.45,1.5,1.75,2,2.5,3,4,5];
              function sR(n,k,lo,hi){var v=p.get(k);if(v==null)return;var x=parseInt(v,10);if(isNaN(x))return;x=Math.max(lo,Math.min(hi,x));f.elements[n].value=x;return x}
              function sC(n,k){var v=p.get(k);if(v==null)return;f.elements[n].checked=v==='1'||v==='on'||v==='true'}
              function sS(n,k,ok){var v=p.get(k);if(v==null||ok.indexOf(v)<0)return;f.elements[n].value=v}
              function out(id,t){var e=document.getElementById(id);if(e)e.textContent=t}
              sR('slideCount','sc',3,20);
              var si=sR('slidesPerView','spv',0,16);
              sR('gap','gap',0,32);
              sR('autoplayInterval','interval',1000,8000);
              sR('maxDots','dots',3,21);
              sR('perMove','pm',1,4);
              sS('alignment','align',['left','center','right']);
              sS('direction','dir',['ltr','rtl','ttb']);
              sC('loop','loop');sC('pagination','pag');sC('navigation','nav');
              sC('draggable','drag');sC('autoplay','auto');sC('thumbnails','thumbs');
              if(si!=null){var spv=SPV[Math.max(0,Math.min(SPV.length-1,si))];out('out-spv',spv.toFixed(2).replace(/\.?0+$/,''))}
              var g=f.elements['gap'];if(g)out('out-gap',g.value+'px');
              var iv=f.elements['autoplayInterval'];if(iv)out('out-interval',iv.value+'ms');
              var sc=f.elements['slideCount'];if(sc)out('out-slideCount',sc.value);
              var d=f.elements['maxDots'];if(d)out('out-maxDots',parseInt(d.value)>=21?'∞':d.value);
              var pm=f.elements['perMove'];if(pm)out('out-perMove',pm.value);
              var ac=f.elements['autoplay'];
              var ic=document.getElementById('interval-control');
              if(ac&&ic){ic.classList.toggle('opacity-40',!ac.checked);ic.classList.toggle('pointer-events-none',!ac.checked)}
            })();
          </script>
        </aside>
      </div>
    </section>

