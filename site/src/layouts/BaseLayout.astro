---
import "aero-slider/slider.css";
import "../styles/global.css";
import manropeUrl from "@fontsource-variable/manrope/files/manrope-latin-wght-normal.woff2?url";
import soraUrl from "@fontsource-variable/sora/files/sora-latin-wght-normal.woff2?url";
import geistMonoUrl from "@fontsource-variable/geist-mono/files/geist-mono-latin-wght-normal.woff2?url";

interface Props {
  title: string;
  description?: string;
  image?: string;
}

const { 
  title,
  description = "A lightweight, CSS-first slider library for the modern web.",
  image = "/og-image.png"
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="color-scheme" content="dark" />
    <meta name="theme-color" content="#08090a" />
    <title>{title}</title>
    <meta name="title" content={title} />
    <meta name="description" content={description} />

    <!-- Open Graph / Facebook -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={Astro.url} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={new URL(image, Astro.url)} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="Aero Slider: CSS-first slider for the modern web" />

    <!-- Twitter -->
    <meta property="twitter:card" content="summary_large_image" />
    <meta property="twitter:url" content={Astro.url} />
    <meta property="twitter:title" content={title} />
    <meta property="twitter:description" content={description} />
    <meta property="twitter:image" content={new URL(image, Astro.url)} />
    <meta property="twitter:image:alt" content="Aero Slider: CSS-first slider for the modern web" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preload" href={manropeUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={soraUrl} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={geistMonoUrl} as="font" type="font/woff2" crossorigin />
    <!-- Hero slider defaults match config form to prevent layout shift before JS -->
    <style is:inline id="hero-defaults">
      #hero-slider{--aero-slides-per-view:1;--aero-slide-gap:10px}
    </style>
    <slot name="head" />
  </head>
  <body class="overflow-x-hidden">
    <!-- Critical: inject hero slider CSS from URL params before first paint -->
    <script is:inline>
      (function(){
        var q = typeof location !== 'undefined' && location.search;
        if (!q || q.length < 2) return;
        var p = new URLSearchParams(q);
        var SPV = [1,1.05,1.1,1.15,1.2,1.25,1.3,1.35,1.4,1.45,1.5,1.75,2,2.5,3,4,5];
        var parts = [];
        var spvIdx = parseInt(p.get('spv'), 10);
        var spvVal = 1;
        if (!isNaN(spvIdx) && spvIdx >= 0 && spvIdx < SPV.length) {
          spvVal = SPV[spvIdx];
          parts.push('--aero-slides-per-view:' + spvVal);
        }
        var gap = parseInt(p.get('gap'), 10);
        if (!isNaN(gap) && gap >= 0 && gap <= 32) {
          parts.push('--aero-slide-gap:' + gap + 'px');
        }
        var align = p.get('align');
        align = { left: 'start', right: 'end' }[align] || align;
        if (align !== 'start' && align !== 'end' && align !== 'center') {
          align = 'center';
        }
        var loop = p.get('loop') === '1' || p.get('loop') === 'on' || p.get('loop') === 'true';
        if (parts.length) {
          var s = document.createElement('style');
          s.id = 'config-inline';
          s.textContent = '#hero-slider{' + parts.join(';') + '}';
          document.head.appendChild(s);
        }
        if (loop && align !== 'start') {
          document.documentElement.setAttribute('data-aero-defer-hero', '');
          var offset = align === 'end'
            ? 'calc(100cqi - (100cqi - var(--aero-slide-gap,0px) * (var(--aero-slides-per-view,1) - 1)) / var(--aero-slides-per-view,1))'
            : 'calc(50cqi - (100cqi - var(--aero-slide-gap,0px) * (var(--aero-slides-per-view,1) - 1)) / (2 * var(--aero-slides-per-view,1)))';
          var snap = align === 'end' ? 'end' : 'center';
          var s2 = document.createElement('style');
          s2.id = 'config-inline-defer';
          s2.textContent = '[data-aero-defer-hero] #hero-slider .aero-slider__slides::before{content:"";flex:0 0 max(0px,calc(' + offset + ' - var(--aero-slide-gap,0px)));scroll-snap-align:none}[data-aero-defer-hero] #hero-slider .aero-slider__slides>*{scroll-snap-align:' + snap + '}';
          document.head.appendChild(s2);
        }
      })();
    </script>
    <slot />
  </body>
</html>
