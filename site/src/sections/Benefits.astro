---
import { bundleSize } from "../lib/bundle-size";

const kb = (value: number) => value.toFixed(1);

// The size bar is drawn to scale: one KB is `unit` drawing units wide.
const barX = 12;
const unit = Math.min(36, 300 / bundleSize.total);
const jsWidth = bundleSize.js * unit;
const cssWidth = bundleSize.css * unit;
const barEnd = barX + jsWidth + cssWidth;
const barMid = (barX + barEnd) / 2;

// Breakpoints drawing: three viewport widths, each a frame holding 1, 2 and 3 slides.
const viewports = [
  { x: 4, width: 48, label: "390", slides: 1 },
  { x: 66, width: 92, label: "768", slides: 2 },
  { x: 172, width: 144, label: "1280", slides: 3 },
].map((frame) => {
  const inner = frame.width - 10;
  const slideWidth = (inner - 4 * (frame.slides - 1)) / frame.slides;
  return {
    ...frame,
    center: frame.x + frame.width / 2,
    slideXs: Array.from({ length: frame.slides }, (_, i) => frame.x + 5 + i * (slideWidth + 4)),
    slideWidth,
  };
});

// Scroll drawing: a track of slides running past the viewport frame.
const trackXs = [-36, 28, 92, 156, 220, 284];
const inFrame = (x: number) => x >= 86 && x + 56 <= 218;
---

<div class="mt-16 text-left sm:mt-24">
  <div class="draft-sheet draft-sheet--benefits grid lg:grid-cols-12">
    <article class="draft-cell lg:col-span-7">
      <h3>CSS-first</h3>
      <p>Responsive in CSS with media queries instead of JavaScript breakpoint objects.</p>
      <div class="draft-fig-row">
      <svg class="draft-fig" viewBox="0 0 320 146" aria-hidden="true">
        <text x="4" y="12" class="dr-accent-text">--slides-per-view</text>
        <path class="dr-strong" d="M4 20.5H316" />
        {
          viewports.map((frame) => (
            <g>
              <path class="dr-strong" d={`M${frame.center} 20.5V27`} />
              <text x={frame.center} y="40" text-anchor="middle" class="dr-value">
                {frame.slides}
              </text>
              <rect class="dr-faint" x={frame.x + 0.5} y="50.5" width={frame.width - 1} height="53" rx="3" />
              {frame.slideXs.map((x) => (
                <rect class="dr-strong" x={x + 0.5} y="55.5" width={frame.slideWidth - 1} height="43" rx="1.5" />
              ))}
              <path class="dr-strong" d={`M${frame.x + 0.5} 114V122M${frame.x + frame.width - 0.5} 114V122M${frame.x + 0.5} 118.5H${frame.x + frame.width - 0.5}`} />
              <text x={frame.center} y="136" text-anchor="middle">
                {frame.label}
              </text>
            </g>
          ))
        }
      </svg>
      <pre class="draft-note">{`@media (min-width: 768px) {
  .aero-slider {
    `}<b>--slides-per-view: 2;</b>{`
  }
}`}</pre>
      </div>
    </article>

    <article class="draft-cell lg:col-span-5">
      <h3>Native scroll</h3>
      <p>
        The browser does the scrolling. Touch, trackpad and momentum feel native because they are,
        with CSS scroll snapping holding each slide.
      </p>
      <svg class="draft-fig" viewBox="0 0 320 146" aria-hidden="true">
        <text x="86" y="34">viewport</text>
        <path class="dr-accent" d="M168 30.5H220M215 26.5L220 30.5L215 34.5" />
        {
          trackXs.map((x) =>
            inFrame(x) ? (
              <rect class="dr-faint" x={x + 0.5} y="54.5" width="55" height="45" rx="1.5" />
            ) : (
              <rect class="dr-strong dr-dashed" x={x + 0.5} y="54.5" width="55" height="45" rx="1.5" />
            )
          )
        }
        <rect class="dr-muted" x="86.5" y="46.5" width="131" height="61" rx="3" />
        <path class="dr-strong" d="M0 120.5H320" />
        {
          trackXs.map((x) => (
            <path class={inFrame(x) ? "dr-faint" : "dr-strong"} d={`M${x + 28.5} 116V125`} />
          ))
        }
        <text x="4" y="138">snap points</text>
        <text x="316" y="138" text-anchor="end">track</text>
      </svg>
    </article>

    <article class="draft-cell lg:col-span-5">
      <h3>Zero layout shift</h3>
      <p>
        Slides get their size from CSS before any JavaScript runs, so nothing jumps when the slider
        starts.
      </p>
      <svg class="draft-fig" viewBox="0 0 320 146" style="overflow: visible" aria-hidden="true">
        <defs>
          <pattern id="fig3-hatch" width="6" height="6" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <path class="dr-strong" d="M0 0V6" />
          </pattern>
        </defs>
        <path class="dr-strong" d="M12.5 12V22M272.5 12V22M12.5 17.5H114M171 17.5H272.5" />
        <text x="142.5" y="21" text-anchor="middle">viewport</text>
        <rect class="dr-faint" x="12.5" y="32.5" width="260" height="82" rx="3" />
        <rect x="13" y="38" width="61" height="71" fill="url(#fig3-hatch)" stroke="none" />
        <path class="dr-faint dr-dashed" d="M12.5 37.5H72.5Q74.5 37.5 74.5 39.5V107.5Q74.5 109.5 72.5 109.5H12.5" />
        <path class="dr-strong dr-dashed" d="M-12 37.5H6M-12 109.5H6" />
        <rect class="dr-accent" x="82.5" y="37.5" width="120" height="72" rx="2" />
        <text x="142.5" y="77" text-anchor="middle" class="dr-value">5 : 3</text>
        <path class="dr-muted" d="M272.5 37.5H212.5Q210.5 37.5 210.5 39.5V107.5Q210.5 109.5 212.5 109.5H272.5" />
        <path class="dr-strong dr-dashed" d="M279 37.5H297M279 109.5H297" />
        <text x="13" y="132">reserved before js</text>
        <text x="272" y="132" text-anchor="end">next slide</text>
      </svg>
    </article>

    <article class="draft-cell lg:col-span-7">
      <h3>~{Math.round(bundleSize.total)} KB, zero dependencies</h3>
      <p>
        {kb(bundleSize.js)} KB of JavaScript and {kb(bundleSize.css)} KB of CSS, gzipped. Nothing else
        to install.
      </p>
      <svg class="draft-fig" viewBox="0 0 320 146" aria-hidden="true">
        <defs>
          <pattern id="fig4-hatch" width="5" height="5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <path class="dr-strong" d="M0 0V5" />
          </pattern>
          <pattern id="fig4-hatch-dense" width="2.5" height="2.5" patternUnits="userSpaceOnUse" patternTransform="rotate(45)">
            <path class="dr-faint" d="M0 0V2.5" />
          </pattern>
        </defs>
        <text x={barX} y="40">js {kb(bundleSize.js)} KB</text>
        <text x={barEnd} y="40" text-anchor="end">css {kb(bundleSize.css)} KB</text>
        <path class="dr-strong" d={`M${barX + 0.5} 44V50M${barEnd - 0.5} 44V50`} />
        <rect x={barX + 0.5} y="52.5" width={jsWidth} height="22" fill="url(#fig4-hatch)" />
        <rect x={barX + jsWidth + 0.5} y="52.5" width={cssWidth - 1} height="22" fill="url(#fig4-hatch-dense)" />
        <rect class="dr-faint" x={barX + 0.5} y="52.5" width={jsWidth + cssWidth - 1} height="22" rx="1" />
        <path class="dr-faint" d={`M${barX + jsWidth + 0.5} 52.5V74.5`} />
        <path class="dr-accent" d={`M${barX + 0.5} 82V94M${barEnd - 0.5} 82V94M${barX + 0.5} 88.5H${barMid - 40}M${barMid + 40} 88.5H${barEnd - 0.5}`} />
        <text x={barMid} y="92" text-anchor="middle" class="dr-accent-text">
          {kb(bundleSize.total)} KB gzip
        </text>
        <path class="dr-strong" d={`M${barX + 0.5} 120V128M${barX + unit + 0.5} 120V128M${barX + 0.5} 124.5H${barX + unit + 0.5}`} />
        <text x={barX + unit + 8} y="128">1 KB</text>
        <text x={barEnd} y="128" text-anchor="end" class="dr-value">0 dependencies</text>
      </svg>
    </article>
  </div>
</div>
