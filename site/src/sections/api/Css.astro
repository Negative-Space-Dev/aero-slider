---
import Entry from "../../components/Entry.astro";
import RefList from "../../components/RefList.astro";
import { attributes, cssVariables, forExtension } from "../../data/api";

const groups = [
  { title: "Custom properties", entries: cssVariables },
  { title: "HTML attributes", entries: forExtension(attributes) },
];
---

<Entry tag="CSS" title="Variables and attributes" id="api-css">
  <div class="copy">
    <p>
      Size and spacing live in CSS, set on the container. The slider re-measures on its own when
      the container or a slide changes size, including from media queries and loaded images. After
      you change a variable from script, call <code>refresh()</code>.
    </p>
  </div>
  <RefList groups={groups} />
  <p class="note">
    The slider also adds state classes such as <code>aero-slider--dragging</code> to the container.
    They are listed under <a href="#api-states">States</a>.
  </p>
</Entry>
