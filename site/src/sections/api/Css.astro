---
import Entry from "../../components/Entry.astro";
import RefList from "../../components/RefList.astro";
import { attributes, cssVariables } from "../../data/api";

const groups = [
  { title: "Custom properties", entries: cssVariables },
  { title: "HTML attributes", entries: attributes },
];
---

<Entry tag="CSS" title="Variables and attributes" id="api-css">
  <div class="copy">
    <p>
      Size and spacing live in CSS, set on the container. Change them in media queries and the slider
      re-measures on its own. It also re-measures when any slide changes size, as when an image
      loads.
    </p>
  </div>
  <RefList groups={groups} />
  <p class="note">
    The slider also adds state classes such as <code>aero-slider--dragging</code> to the container.
    They are listed under <a href="#api-states">States</a>.
  </p>
</Entry>
