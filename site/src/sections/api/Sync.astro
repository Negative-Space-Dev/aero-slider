---
import ExtensionDemo from "../../components/ExtensionDemo.astro";
import ExtensionRef from "../../components/ExtensionRef.astro";
import RefList from "../../components/RefList.astro";
import type { RefGroup } from "../../data/api";

const groups: RefGroup[] = [
  {
    title: "Parameters",
    entries: [
      { name: "primary", type: "SliderInstance", description: "The main slider." },
      {
        name: "thumbnails",
        type: "SliderInstance",
        description:
          "The thumbnail strip. It needs the same number of slides as <code>primary</code>.",
      },
      {
        name: "options.loop",
        type: "boolean",
        default: "true",
        description:
          'Whether the strip loops. Looping needs the <a href="#api-loop">loop extension</a>.',
      },
    ],
  },
  {
    title: "Returns",
    entries: [
      {
        name: "teardown",
        type: "() => void",
        description:
          "Removes the sync. Call it before destroying either slider.",
      },
    ],
  },
];

const behaviours = [
  "Sets the strip's <code>loop</code> option. The strip can still be dragged.",
  "Clicking a thumbnail shows that slide in <code>primary</code>.",
  "Marks the active thumbnail with <code>aero-slider__thumb--active</code> and <code>aria-current=\"true\"</code>, and scrolls the strip to keep it in view.",
  'Gives thumbnails that aren\'t already buttons or links <code>role="button"</code> and <code>tabindex="0"</code>, so the keyboard can reach them. One with no label gets <code>aria-label="Go to slide N"</code>.',
  'Set <code>alignment: "center"</code> on the strip to keep the active thumbnail centered.',
  "Teardown removes the sync's listeners, classes and attributes. It doesn't destroy either slider.",
];
---

<ExtensionRef
  extension="thumbnails"
  title="Thumbnails"
  id="api-thumbnails"
  requires='The core, and the <a href="#api-loop">loop extension</a> for a looping strip, which is the default.'
  files={["aero-slider.thumbnails.min.js"]}
>
  <p>
    Links a thumbnail strip to a main slider: clicking a thumbnail shows that slide, and the
    strip follows the main slider. Both are made with <code>createSlider</code>. See the
    <a href="#ex-gallery">gallery example</a>.
  </p>

  <ExtensionDemo slot="demo" extension="thumbnails">
    <div slot="controls" class="ex-controls">
      <div class="ex-controls__row">
        <span class="caption">Strip loops</span>
        <div id="strip-loop" class="segmented" role="group" aria-label="Strip loops">
          <button type="button" data-loop="on" data-active aria-pressed="true">On</button>
          <button type="button" data-loop="off" aria-pressed="false">Off</button>
        </div>
      </div>
    </div>
  </ExtensionDemo>

  <div slot="reference" class="space-y-5">
    <h4 class="font-mono text-lg" id="api-sync">syncThumbnails(primary, thumbnails, options?)</h4>
    <RefList groups={groups} />
    <div>
      <h4 class="caption api-behaviours__title">What it does</h4>
      <ul class="api-behaviours">
        {behaviours.map((item) => <li set:html={item} />)}
      </ul>
    </div>
  </div>
</ExtensionRef>
