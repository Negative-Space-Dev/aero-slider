---
import ExtensionRef from "../../components/ExtensionRef.astro";
---

<ExtensionRef
  extension="maxDots"
  title="Windowed dots"
  id="api-max-dots"
  files={["dots.min.js", "dots.min.css"]}
>
  <p>
    Shows at most <code>maxDots</code> pagination dots and slides the window along as the slider
    moves, iOS style. Plain dots are in the core; this extension adds only the window. See
    <a href="#ex-max-dots">the windowed dots example</a>.
  </p>
</ExtensionRef>
