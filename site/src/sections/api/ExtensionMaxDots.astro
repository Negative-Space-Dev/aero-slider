---
import ExtensionDemo from "../../components/ExtensionDemo.astro";
import ExtensionRef from "../../components/ExtensionRef.astro";
---

<ExtensionRef
  extension="maxDots"
  title="Windowed dots"
  id="api-max-dots"
  files={["aero-slider.dots.min.js", "aero-slider.dots.min.css"]}
>
  <p>
    Shows at most <code>maxDots</code> pagination dots and slides the window along as the slider
    moves, iOS style. Plain dots are in the core; this extension adds only the window. See
    <a href="#ex-max-dots">the windowed dots example</a>.
  </p>
  <ExtensionDemo slot="demo" extension="maxDots">
    <div slot="controls" class="ex-controls">
      <div class="ex-controls__row">
        <span class="caption">Dots</span>
        <div id="dots-window" class="segmented" role="group" aria-label="Dots shown">
          <button type="button" data-max="5" data-active aria-pressed="true">5 dots</button>
          <button type="button" data-max="0" aria-pressed="false">Every dot</button>
        </div>
      </div>
    </div>
  </ExtensionDemo>
</ExtensionRef>
