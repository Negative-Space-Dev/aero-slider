---
import ExtensionDemo from "../../components/ExtensionDemo.astro";
import ExtensionRef from "../../components/ExtensionRef.astro";
---

<ExtensionRef extension="loop" title="Loop" id="api-loop" files={["aero-slider.loop.min.js", "aero-slider.loop.min.css"]}>
  <p>
    Wraps from the last slide back to the first, using clones of the slides on both sides of the
    track. Clones are hidden from screen readers, the tab order and forms.
  </p>
  <p>
    Cloned custom elements start up when inserted, so measure them in a
    <code>ResizeObserver</code>, not in the constructor.
  </p>
  <ExtensionDemo slot="demo" extension="loop">
    <div slot="controls" class="ex-controls">
      <div class="ex-controls__row">
        <span class="caption">Loop</span>
        <div id="loop-switch" class="segmented" role="group" aria-label="Loop">
          <button type="button" data-loop="on" data-active aria-pressed="true">On</button>
          <button type="button" data-loop="off" aria-pressed="false">Off</button>
        </div>
      </div>
    </div>
  </ExtensionDemo>
</ExtensionRef>
