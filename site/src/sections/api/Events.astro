---
import ApiEventList from "../../components/ApiEventList.astro";
import CodeTabs from "../../components/CodeTabs.astro";
import Entry from "../../components/Entry.astro";
import { eventEntryGroups } from "../../data/api";
import type { CodeTab } from "../../lib/code";

const listen: CodeTab[] = [
  {
    label: "Listen",
    lang: "javascript",
    code: `el.addEventListener("aero:slideChange", (event) => {
  console.log(event.detail.index);
});`,
  },
];

const gotchas = [
  {
    title: "Listen before you create",
    body: "<code>aero:ready</code> fires inside <code>createSlider</code>, before it returns, and so does the first <code>aero:autoplayStart</code>. A listener added afterwards never hears them.",
  },
  {
    title: "Touch fires no drag events",
    body: "A finger swipe scrolls the track natively, so <code>aero:dragStart</code> and <code>aero:dragEnd</code> come from a mouse or pen only. To follow every way of moving, use <code>aero:slideChange</code>.",
  },
  {
    title: "One listener for every slider",
    body: "Events bubble, so a listener on <code>document</code> hears every slider on the page. <code>event.target</code> is the container and <code>event.target.aeroSlider</code> its instance. If sliders nest, check <code>event.target === el</code>.",
  },
];

const typed: CodeTab[] = [
  {
    label: "TypeScript",
    lang: "typescript",
    code: `import type { SliderEventData } from "aero-slider";

el.addEventListener("aero:dragEnd", (event) => {
  const { detail } = event as CustomEvent<SliderEventData<"dragEnd">>;
  console.log(detail.fromIndex, detail.index);
});`,
  },
];
---

<Entry tag="DOM events" title="Events" id="api-events">
  <div class="api-split">
    <div class="copy">
      <p>
        The slider reports what it does as events on its container. Each is a native
        <code>CustomEvent</code> named with the <code>aero:</code> prefix, carries its data on
        <code>event.detail</code>, and bubbles.
      </p>
      <p>
        Each event below says when it fires and what it is useful for, with a recipe to copy. In
        the recipes, <code>el</code> is the container.
      </p>
    </div>
    <CodeTabs tabs={listen} />
  </div>

  <div class="api-ref-columns">
    <ApiEventList groups={eventEntryGroups} />
  </div>

  <div class="draft-sheet api-gotchas">
    {
      gotchas.map((gotcha, i) => (
        <div class="draft-cell">
          <div class="draft-cell__meta">
            <span>Note {String(i + 1).padStart(2, "0")}</span>
            <span>Gotcha</span>
          </div>
          <h4>{gotcha.title}</h4>
          <p set:html={gotcha.body} />
        </div>
      ))
    }
  </div>

  <div class="api-split">
    <div class="copy">
      <p>
        <strong>TypeScript.</strong> <code>addEventListener</code> types these events as a plain
        <code>Event</code>. Cast to <code>CustomEvent</code> with the exported
        <code>SliderEventData</code> to type <code>detail</code>.
      </p>
    </div>
    <CodeTabs tabs={typed} />
  </div>
</Entry>
