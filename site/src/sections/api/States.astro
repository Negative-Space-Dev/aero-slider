---
import Entry from "../../components/Entry.astro";
import RefList from "../../components/RefList.astro";
import { controlStates, forExtension, stateClasses } from "../../data/api";

const groups = [
  { title: "Container states", entries: stateClasses },
  { title: "Control states", entries: forExtension(controlStates) },
];
---

<Entry tag="CSS" title="States" id="api-states">
  <div class="copy">
    <p>
      Classes the slider sets on the container and its controls. See
      <a href="#ex-styling">arrows, dots and their states</a> for an example.
    </p>
  </div>
  <RefList groups={groups} />
</Entry>
