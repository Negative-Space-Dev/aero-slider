---
import BoxIcon from "../components/icons/BoxIcon.astro";
import Benefits from "./Benefits.astro";
import { bundleSize } from "../lib/bundle-size";
import { REPO } from "../lib/site";

const packageManagers = ["bun", "npm", "yarn", "pnpm"];
const kb = (value: number) => value.toFixed(1);
---

<section class="container-page pt-12 text-center sm:pt-20">
  <div class="mb-6 flex flex-wrap items-center justify-center gap-3">
    <span class="caption inline-flex items-center gap-2 rounded-full border border-line bg-surface text-subtle px-3 py-1.5">
      <BoxIcon class="size-3.5 text-accent" />
      {kb(bundleSize.core.total)} KB core · {kb(bundleSize.full.total)} KB full · 0 dependencies
    </span>
  </div>

  <h1 class="mx-auto max-w-2xl text-[clamp(1.75rem,9.3vw,4.25rem)] leading-[1.05] font-medium tracking-[-0.02em] text-balance">
    CSS-first slider for the modern web
  </h1>


  <!-- Install Widget -->
  <div id="install-widget" class="mx-auto mt-8 max-w-md sm:mt-10 rounded-xl border border-line bg-surface text-left">
    <div class="flex items-center justify-between border-b border-line pr-2 pl-1.5">
      <div class="flex">
        {
          packageManagers.map((pm, i) => (
            <button
              type="button"
              data-pm={pm}
              data-active={i === 0 ? "" : undefined}
              aria-pressed={String(i === 0)}
              class="install-tab -mb-px border-b border-transparent px-2.5 py-2.5 font-mono text-xs text-subtle transition-colors hover:text-ink data-[active]:border-accent data-[active]:text-ink"
            >
              {pm}
            </button>
          ))
        }
      </div>
      <a
        href={`${REPO}/releases/latest`}
        target="_blank"
        rel="noopener noreferrer"
        class="flex items-center gap-1.5 rounded-md px-2 py-1 font-mono text-xs text-subtle transition-colors hover:text-ink"
        title="Download .zip"
      >
        <svg class="size-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-4l-4 4m0 0l-4-4m4 4V4"></path>
        </svg>
        .zip
      </a>
    </div>
    <div class="flex items-center justify-between gap-3 py-2.5 pr-2.5 pl-4">
      <p class="min-w-0 truncate font-mono text-sm text-ink">
        <span class="text-subtle select-none" aria-hidden="true">$ </span><span id="install-command">bun add aero-slider</span>
      </p>
      <button
        id="copy-install"
        type="button"
        class="rounded-md p-2 text-subtle transition-colors hover:bg-line hover:text-ink"
        aria-label="Copy to clipboard"
      >
        <svg id="copy-icon" class="size-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect>
          <path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path>
        </svg>
        <svg id="check-icon" class="hidden size-4 text-accent" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <polyline points="20 6 9 17 4 12"></polyline>
        </svg>
      </button>
    </div>
  </div>

  <p class="mt-5 flex justify-center text-sm">
    <a href="/aeroslider.md" class="btn">
      AI Guide
      <span class="font-mono text-xs font-normal text-subtle">aeroslider.md</span>
    </a>
  </p>

  <Benefits />
</section>
