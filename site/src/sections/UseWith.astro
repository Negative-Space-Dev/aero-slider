---
import CodeTabs from "../components/CodeTabs.astro";
import Disclosure from "../components/Disclosure.astro";
import type { CodeTab } from "../lib/code";

const frameworks: { name: string; note: string; tabs: CodeTab[] }[] = [
  {
    name: "React",
    note: "Create the slider in an effect and destroy it in the effect's cleanup.",
    tabs: [
      {
        label: "Slider.jsx",
        lang: "tsx",
        code: `import { useEffect, useRef } from "react";
import { createSlider } from "aero-slider";
import "aero-slider/slider.css";

export function Slider({ children }) {
  const ref = useRef(null);

  useEffect(() => {
    const slider = createSlider(ref.current, { loop: true });
    return () => slider.destroy();
  }, []);

  return (
    <div ref={ref} className="aero-slider">
      <div className="aero-slider__viewport">
        <div className="aero-slider__track">{children}</div>
      </div>
    </div>
  );
}`,
      },
    ],
  },
  {
    name: "Vue",
    note: "Create the slider in <code>onMounted</code> and destroy it in <code>onBeforeUnmount</code>.",
    tabs: [
      {
        label: "Slider.vue",
        lang: "vue",
        code: `<script setup>
import { onBeforeUnmount, onMounted, ref } from "vue";
import { createSlider } from "aero-slider";
import "aero-slider/slider.css";

const el = ref(null);
let slider;

onMounted(() => {
  slider = createSlider(el.value, { loop: true });
});
onBeforeUnmount(() => slider?.destroy());
</script>

<template>
  <div ref="el" class="aero-slider">
    <div class="aero-slider__viewport">
      <div class="aero-slider__track">
        <slot />
      </div>
    </div>
  </div>
</template>`,
      },
    ],
  },
  {
    name: "Shopify",
    note: "Upload <code>aero-slider.min.js</code> and <code>aero-slider.min.css</code> to the theme's assets. A custom element creates the slider when the section is added and destroys it when it is removed, so it also works in the theme editor.",
    tabs: [
      {
        label: "sections/slider.liquid",
        lang: "liquid",
        code: `{{ 'aero-slider.min.css' | asset_url | stylesheet_tag }}

<aero-slider-section>
  <div class="aero-slider">
    <div class="aero-slider__viewport">
      <div class="aero-slider__track">
        {%- for block in section.blocks -%}
          <div {{ block.shopify_attributes }}>
            {{ block.settings.image | image_url: width: 1600 | image_tag }}
          </div>
        {%- endfor -%}
      </div>
    </div>
  </div>
</aero-slider-section>

<script type="module">
  import { createSlider } from "{{ 'aero-slider.min.js' | asset_url }}";

  if (!customElements.get("aero-slider-section")) {
    customElements.define(
      "aero-slider-section",
      class extends HTMLElement {
        connectedCallback() {
          this.slider = createSlider(this.querySelector(".aero-slider"), { loop: true });
        }
        disconnectedCallback() {
          this.slider?.destroy();
        }
      }
    );
  }
</script>

{% schema %}
{
  "name": "Slider",
  "blocks": [
    {
      "type": "slide",
      "name": "Slide",
      "settings": [{ "type": "image_picker", "id": "image", "label": "Image" }]
    }
  ],
  "presets": [{ "name": "Slider" }]
}
{% endschema %}`,
      },
    ],
  },
];
---

<section id="use-with" class="container-page py-12 sm:py-16">
  <h2 class="mb-6 text-3xl font-medium tracking-[-0.025em] sm:text-4xl">Use with</h2>
  <div class="copy">
    <p>
      The slider is plain DOM: create it once its element is on the page and destroy it when the
      element goes away.
    </p>
  </div>
  <ul class="mt-8 border-t border-line">
    {
      frameworks.map((framework) => (
        <li class="border-b border-line py-4">
          <Disclosure label={framework.name} class="disclosure--row">
            <p class="copy mb-4 text-[0.9375rem]" set:html={framework.note} />
            <CodeTabs tabs={framework.tabs} />
          </Disclosure>
        </li>
      ))
    }
  </ul>
</section>
