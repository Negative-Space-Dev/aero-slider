---
import Example from "../components/Example.astro";
import { exampleIds } from "../data/anchors";
import { exampleGroups, examples, variantOptions } from "../data/examples";
import "../styles/examples.css";

const indexOf = (id: (typeof exampleIds)[number]) => exampleIds.indexOf(id) + 1;
const groups = exampleGroups.map((group) => ({
  ...group,
  ids: exampleIds.filter((id) => examples[id].group === group.key),
}));
---

<section id="examples" class="container-page py-12 sm:py-16">
  <h2 class="mb-10 text-3xl font-medium tracking-[-0.025em] sm:mb-14 sm:text-4xl">Examples</h2>

  {
    groups.map((group) => (
      <section id={group.id} class="ex-group" aria-labelledby={`${group.id}-title`}>
        <h3 id={`${group.id}-title`} class="caption ex-group__title">
          {group.title}
        </h3>
        {group.ids.map((id) =>
          id === "ex-edge-to-edge" ? (
            <Example id={id} index={indexOf(id)}>
              <div slot="controls" class="ex-controls">
                <span class="caption">Alignment</span>
                <div id="edge-align" class="segmented" role="group" aria-label="Edge-to-edge alignment">
                  <button type="button" data-align="start" data-active>
                    Start
                  </button>
                  <button type="button" data-align="center">
                    Center
                  </button>
                  <button type="button" data-align="end">
                    End
                  </button>
                </div>
              </div>
              <div slot="controls" class="ex-guide" aria-hidden="true">
                <div class="ex-guide__column">
                  <span class="caption">Content column</span>
                </div>
              </div>
            </Example>
          ) : id === "ex-variants" ? (
            <Example id={id} index={indexOf(id)}>
              <div slot="controls" class="ex-controls">
                <div class="ex-controls__row">
                  <span class="caption">Colour</span>
                  <div id="swatches" class="segmented" role="group" aria-label="Colour">
                    {variantOptions.map(({ key, label }, i) => (
                      <button type="button" data-variant={key} data-active={i === 0 ? "" : undefined}>
                        <span class="ex-swatch" data-variant={key} />
                        {label}
                      </button>
                    ))}
                  </div>
                </div>
                <div class="ex-controls__row">
                  <span class="caption">On switch</span>
                  <div id="variant-rest" class="segmented" role="group" aria-label="After a colour switch">
                    <button type="button" data-rest="first" data-active>
                      First slide
                    </button>
                    <button type="button" data-rest="same">
                      Same index
                    </button>
                  </div>
                </div>
              </div>
            </Example>
          ) : id === "ex-counter" ? (
            <Example id={id} index={indexOf(id)}>
              <div slot="below" class="ex-progress">
                <p id="gallery-count" class="ex-progress__count">
                  1 / 5
                </p>
                <div class="ex-progress__track">
                  <div id="gallery-bar" />
                </div>
              </div>
            </Example>
          ) : (
            <Example id={id} index={indexOf(id)} />
          )
        )}
      </section>
    ))
  }
</section>

<script>
  import "../scripts/examples.ts";
</script>
