---
import CodeBlock from "../components/CodeBlock.astro";
import DocTable from "../components/DocTable.astro";
import Entry from "../components/Entry.astro";
import {
  attributes,
  cssVariables,
  eventRefGroups,
  globals,
  instanceRefGroups,
  optionRefGroups,
  stateClasses,
} from "../data/api";
import { REPO } from "../lib/site";

const globalRows = globals.map((entry) => [entry.name, entry.description]);
const cssPropertyRows = [...cssVariables, ...attributes].map((entry) => [
  entry.name,
  entry.default ?? "—",
  entry.description,
]);
const stateClassRows = stateClasses.map((entry) => [entry.name, entry.description]);
const configRows = optionRefGroups
  .flatMap((group) => group.entries)
  .map((entry) => [entry.name, entry.type ?? "", entry.default ?? "", entry.description]);
const instanceRows = instanceRefGroups
  .flatMap((group) => group.entries)
  .map((entry) => [entry.name, entry.description]);
const eventRows = eventRefGroups
  .flatMap((group) => group.entries)
  .map((entry) => [entry.name, entry.type ?? "", entry.description]);
---

<section id="api" class="container-page py-12 sm:py-16">
  <h2 class="mb-10 text-3xl font-medium tracking-[-0.025em] sm:mb-14 sm:text-4xl">API Reference</h2>

  <div class="space-y-14 sm:space-y-16">
    <!-- createSlider -->
    <Entry tag="Function" title="createSlider(element, config?)" mono id="api-create">
      <div class="copy">
        <p>
          Creates a new slider instance on the given container element. Pagination and
          navigation are configured via DOM structure, not JavaScript—see the
          <a href="#example-pagination-nav">Pagination &amp; Navigation example</a>
          for required HTML.
        </p>
      </div>
      <CodeBlock
        lang="typescript"
        code={`import { createSlider } from "aero-slider";
import "aero-slider/slider.css";

const slider = createSlider(document.getElementById("my-slider"), {
  loop: true,
  draggable: true,
});`}
      />
      <div class="copy">
        <p>
          <strong>Without a bundler:</strong> Use the global script — see
          <a href="#aeroslider-global">window.AeroSlider</a>.
        </p>
      </div>
    </Entry>

    <!-- Global script (window.AeroSlider) -->
    <Entry tag="Global" title="window.AeroSlider (global script)" mono id="aeroslider-global">
      <div class="copy">
        <p>
          When using the standalone script (no bundler), the library attaches an
          <code>AeroSlider</code>
          object to <code>window</code>
          with two methods: <code>createSlider</code> and
          <code>syncThumbnails</code>. Include the CSS and JS files, then call
          <code>AeroSlider.createSlider()</code> and optionally
          <code>AeroSlider.syncThumbnails()</code>.
        </p>
        <p>
          Use <code>aero-slider.min.js</code> with
          <code>type="module"</code>
          from
          <a href="https://unpkg.com/aero-slider/dist/" target="_blank" rel="noopener noreferrer">unpkg</a>
          or the
          <a href={`${REPO}/releases`} target="_blank" rel="noopener noreferrer">releases</a> page.
        </p>
      </div>
      <CodeBlock
        lang="html"
        code={`<link rel="stylesheet" href="https://unpkg.com/aero-slider/dist/aero-slider.min.css" />
<script type="module" src="https://unpkg.com/aero-slider/dist/aero-slider.min.js"></script>
<script type="module">
  // AeroSlider is on window after the module loads
  const slider = AeroSlider.createSlider(document.getElementById("my-slider"), { loop: true });
</script>`}
      />
      <CodeBlock
        label="With thumbnails"
        lang="javascript"
        code={`const main = AeroSlider.createSlider(mainEl);
const thumbs = AeroSlider.createSlider(thumbsEl);
const teardown = AeroSlider.syncThumbnails(main, thumbs);

// On unmount: teardown(); main.destroy(); thumbs.destroy();`}
      />
      <DocTable
        minWidth={400}
        columns={[{ label: "Property", mono: true, nowrap: true }, { label: "Description" }]}
        rows={globalRows}
      />
    </Entry>

    <!-- CSS Custom Properties -->
    <Entry tag="CSS" title="CSS Custom Properties" id="api-css">
      <div class="copy">
        <p>Layout is controlled via CSS custom properties on the container.</p>
      </div>
      <DocTable
        columns={[
          { label: "Property", mono: true, nowrap: true },
          { label: "Default", mono: "soft", nowrap: true },
          { label: "Description" },
        ]}
        rows={cssPropertyRows}
      />
    </Entry>

    <!-- State classes -->
    <Entry tag="CSS" title="State Classes">
      <div class="copy">
        <p>The slider toggles these classes on the container, so you can style each state.</p>
      </div>
      <DocTable
        columns={[{ label: "Class", mono: true, nowrap: true }, { label: "Present when" }]}
        rows={stateClassRows}
      />
    </Entry>

    <!-- Config -->
    <Entry tag="Options" title="SliderConfig" mono id="api-options">
      <div class="copy">
        <p>All configuration options (all optional with sensible defaults).</p>
      </div>
      <DocTable
        minWidth={820}
        columns={[
          { label: "Option", mono: true, nowrap: true },
          { label: "Type", mono: "soft", nowrap: true },
          { label: "Default", mono: "soft", nowrap: true },
          { label: "Description" },
        ]}
        rows={configRows}
      />
    </Entry>

    <!-- Instance Methods -->
    <Entry tag="Instance" title="SliderInstance" mono id="api-methods">
      <div class="copy">
        <p>Returned by <code>createSlider()</code>.</p>
      </div>
      <p class="note">
        The instance is also attached to the container element. You can access it via
        <code>container.aeroSlider</code> when you have a reference to the DOM element.
      </p>
      <DocTable
        columns={[{ label: "Method / Property", mono: true, nowrap: true }, { label: "Description" }]}
        rows={instanceRows}
      />
      <div class="copy">
        <p>
          For syncing a main slider with a thumbnail strip, use the standalone
          <code>syncThumbnails(primary, thumbnail)</code>
          function (see below).
        </p>
      </div>
    </Entry>

    <!-- syncThumbnails -->
    <Entry tag="Function" title="syncThumbnails(primary, thumbnail, options?)" mono id="api-sync">
      <div class="copy">
        <p>
          Syncs a primary slider with a thumbnail slider. Clicking a thumbnail navigates the
          primary to that slide; when the primary changes (drag, arrows, etc.), the thumbnail
          slider scrolls to keep the active thumbnail in view and adds
          <code>aero-slider__thumb--active</code>
          to it. The function does not force thumbnail alignment; set
          <code>alignment: "center"</code>
          on the thumbnail slider if you want the active thumb centered when possible. Both
          sliders must have the same number of slides. Pass an optional third argument
          <code>{"{ loop }"}</code>
          to control whether the thumbnail strip loops (defaults to
          <code>true</code>). Returns a teardown function — call it before destroying the
          sliders.
        </p>
      </div>
      <CodeBlock
        lang="typescript"
        code={`import { createSlider, syncThumbnails } from "aero-slider";

const main = createSlider(mainEl);
const thumbs = createSlider(thumbsEl, {
  alignment: "center",
});
const teardown = syncThumbnails(main, thumbs);

// On unmount:
// teardown();
// main.destroy();
// thumbs.destroy();`}
      />
    </Entry>

    <!-- Events -->
    <Entry tag="DOM events" title="Events" id="api-events">
      <div class="copy">
        <p>
          Aero Slider dispatches native DOM events on the container element, prefixed with
          <code>aero:</code>. Event data is available via <code>event.detail</code>.
        </p>
      </div>
      <p class="note">
        Listen with <code>addEventListener</code>
        on the container. Access the slider instance via
        <code>event.currentTarget.aeroSlider</code> in any handler.
      </p>
      <CodeBlock
        lang="typescript"
        code={`const el = document.getElementById("my-slider");
const slider = createSlider(el, { loop: true });

el.addEventListener("aero:slideChange", (event) => {
  console.log("active slide:", event.detail.index);
});`}
      />
      <DocTable
        minWidth={720}
        columns={[
          { label: "Event", mono: true, nowrap: true },
          { label: "Data (event.detail, TS type)", mono: "soft" },
          { label: "Description" },
        ]}
        rows={eventRows}
      />
    </Entry>
  </div>
</section>
